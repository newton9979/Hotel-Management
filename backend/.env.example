PORT=4000
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=12h

# PostgreSQL (use your RDS endpoint on AWS)
DATABASE_URL=postgres://hotel_admin:password@localhost:5432/hotels
# Set to true for AWS RDS
DB_SSL=false
# Pool size per Node process (RDS db.t3.micro allows ~80 connections)
DB_POOL_MAX=20

# bcrypt cost (10 recommended in production)
BCRYPT_ROUNDS=10

# Comma separated list of allowed origins, or * for all
CORS_ORIGIN=*
